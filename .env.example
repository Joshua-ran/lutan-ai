# 仅供 server/index.ts 读取；复制为 .env 后填写。请勿使用 VITE_ 前缀存放密钥。
# 默认无密钥规则模式，完全可用。开启后只在普通且用户自述已核验合法时调用。
LLM_ENABLED=false
# 使用 DeepSeek 时设 deepseek，密钥可仅放在 DEEPSEEK_API_KEY 环境变量中。
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# 非敏感展示名；默认不将实际模型 ID 或 API 地址返回到前端。
LLM_MODEL_LABEL=configured-model

# 通用表单默认 2500ms；DeepSeek 建议 20000ms，服务端最大60000ms，前端诊断最大65000ms。
LLM_TIMEOUT_MS=2500
LLM_MAX_OUTPUT_TOKENS=384
LLM_REQUESTS_PER_MINUTE=20
LLM_DAILY_REQUEST_LIMIT=100
LLM_MAX_CONCURRENCY=2

# 供应商须兼容 POST /chat/completions。
# 不支持 json_schema 时显式改为 json_object；服务端仍做相同 Zod 与证据校验。
LLM_RESPONSE_FORMAT=json_schema
# 供应商不支持 max_completion_tokens 时可改为 max_tokens。
LLM_TOKEN_PARAMETER=max_completion_tokens
# 日志仅包含规则 ID、模式、回退码和耗时；无输入、地址、密钥、IP 或模型原文。
LLM_LOG_EVENTS=false

# 通用模型只有确认支持图片时才设 true；deepseek-flash 的 DeepSeek 预设自动启用。
LLM_VISION_ENABLED=false
LLM_TOOLS_ENABLED=true
# DeepSeek 预设：LLM_PROVIDER=deepseek、LLM_MODEL=deepseek-flash、
# LLM_BASE_URL=https://api.deepseek.com、LLM_RESPONSE_FORMAT=json_object、
# LLM_TOKEN_PARAMETER=max_tokens。不要用 deepseek-v4-pro 发送图片。
